def _binding(value: str, *, lang: str | None = None, kind: str = "literal") -> dict[str, str]:
    out = {"type": kind, "value": value}
    if lang:
        out["xml:lang"] = lang
    return out


def _page(rows: list[dict]) -> list[PageResult]:
    return [PageResult(rows=rows, raw_path="raw.json", sha256="0" * 64)]


